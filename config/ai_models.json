{
    "execution": {
        "mode": "local",
        "device": "auto",
        "fallback": "cpu"
    },
    "models": {
        "language_model": {
            "enabled": true,
            "provider": "ollama",
            "model": "qwen3:8b",
            "thinking": false,
            "timeout": 900
        },
        "video_model": {
            "enabled": true,
            "provider": "wan",
            "model": "Wan-AI/Wan2.1-T2V-1.3B-Diffusers",
            "steps": {
                "cpu": 8,
                "cuda": 20
            },
            "guidance_scale": 6.0,
            "negative_prompt": "static image, blurry, distorted, low quality, deformed, duplicate objects, text, subtitles, watermark"
        },
        "audio_model": {
            "enabled": true,
            "provider": "local_audio"
        }
    }
}