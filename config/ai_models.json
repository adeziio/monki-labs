{
    "execution": {
        "mode": "hybrid",
        "fallback": "cpu"
    },
    "models": {
        "language_model": {
            "enabled": true,
            "provider": "ollama",
            "model": "llama3",
            "device": "cpu"
        },
        "image_model": {
            "enabled": true,
            "provider": "stable_diffusion",
            "device": "auto",
            "optimization": [
                "cuda",
                "mps",
                "cpu"
            ]
        },
        "animation_model": {
            "enabled": true,
            "provider": "animatediff",
            "device": "auto"
        },
        "audio_model": {
            "enabled": true,
            "provider": "local_audio",
            "device": "cpu"
        }
    }
}