{
    "execution": {
        "mode": "hybrid",
        "fallback": "cpu"
    },
    "models": {
        "language_model": {
            "enabled": true,
            "provider": "ollama",
            "model": "qwen3:8b",
            "device": "cpu"
        },
        "image_model": {
            "enabled": true,
            "provider": "flux",
            "model": "black-forest-labs/FLUX.1-schnell",
            "output_directory": "media/scenes",
            "height": 1024,
            "width": 1024,
            "num_inference_steps": 4,
            "guidance_scale": 1.0
        },
        "animation_model": {
            "enabled": true,
            "provider": "wan_video",
            "model": "Wan-AI/Wan2.1-I2V-14B-720P-Diffusers",
            "device": "auto",
            "frames": 17,
            "fps": 8
        },
        "audio_model": {
            "enabled": true,
            "provider": "local_audio",
            "device": "cpu"
        }
    }
}