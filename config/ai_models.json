{
    "execution": {
        "mode": "hybrid",
        "fallback": "cpu"
    },
    "models": {
        "language_model": {
            "enabled": true,
            "provider": "ollama",
            "model": "llama3",
            "device": "cpu"
        },
        "image_model": {
            "enabled": true,
            "provider": "diffusers",
            "model": "runwayml/stable-diffusion-v1-5",
            "output_directory": "media/scenes"
        },
        "animation_model": {
            "enabled": true,
            "provider": "wan_video",
            "model": "Wan-AI/Wan2.1-I2V-14B-720P-Diffusers",
            "device": "auto",
            "frames": 17,
            "fps": 8
        },
        "audio_model": {
            "enabled": true,
            "provider": "local_audio",
            "device": "cpu"
        }
    }
}