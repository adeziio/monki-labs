{
    "execution": {
        "mode": "hybrid",
        "fallback": "cpu"
    },
    "models": {
        "language_model": {
            "enabled": true,
            "provider": "ollama",
            "model": "llama3",
            "device": "cpu"
        },
        "image_model": {
            "enabled": true,
            "provider": "diffusers",
            "model": "runwayml/stable-diffusion-v1-5",
            "output_directory": "media/scenes"
        },
        "animation_model": {
            "enabled": true,
            "provider": "animatediff",
            "device": "auto"
        },
        "audio_model": {
            "enabled": true,
            "provider": "local_audio",
            "device": "cpu"
        }
    }
}