{
    "execution": {
        "mode": "local",
        "device": "auto",
        "fallback": "cpu"
    },
    "models": {
        "language_model": {
            "enabled": true,
            "provider": "ollama",
            "model": "qwen3:8b",
            "thinking": false,
            "timeout": 900
        },
        "video_model": {
            "enabled": true,
            "provider": "ltx",
            "model": "diffusers/LTX-2.3-Diffusers",
            "generation_resolution": {
                "width": 512,
                "height": 896
            },
            "generation_fps": 24,
            "steps": {
                "cpu": 8,
                "cuda": 30
            },
            "guidance_scale": 3.0,
            "audio": {
                "enabled": true,
                "music_enabled": true
            },
            "audio_guidance_scale": 7.0,
            "audio_stg_scale": 0.0,
            "audio_modality_scale": 3.0,
            "negative_prompt": "shaky, glitchy, low quality, worst quality, deformed, distorted, disfigured, motion smear, motion artifacts, static, blurry, text, subtitles, watermark"
        }
    }
}