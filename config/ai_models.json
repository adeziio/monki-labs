{
    "execution": {
        "mode": "local",
        "device": "auto",
        "fallback": "cpu"
    },
    "models": {
        "language_model": {
            "enabled": true,
            "provider": "ollama",
            "model": "qwen3:8b",
            "thinking": false,
            "timeout": 900,
            "options": {
                "temperature": 1.15,
                "top_p": 0.95,
                "top_k": 80,
                "repeat_penalty": 1.18,
                "min_p": 0.05
            }
        },
        "video_model": {
            "enabled": true,
            "provider": "api",
            "model": "diffusers/LTX-2.3-Diffusers",
            "api": {
                "base_url": "https://api.ltx.io",
                "submit_path": "/v2/text-to-video",
                "status_path": "/v2/text-to-video/{job_id}",
                "prompt_field": "prompt",
                "send_duration_and_resolution": true,
                "model": "ltx-2-3-fast",
                "extra_params": {},
                "auth_header": "Authorization",
                "auth_scheme": "Bearer",
                "accept_header": "",
                "api_key_env": "LTX_API_KEY",
                "status_field": "status",
                "poll_interval_seconds": 5,
                "timeout_seconds": 900,
                "request_timeout_seconds": 30
            },
            "generation_retry_attempts": 5,
            "generation_retry_backoff_seconds": 20,
            "device_allocation": {
                "mode": "model",
                "vae_tiling": true,
                "vae_slicing": true,
                "attention_slicing": false
            },
            "generation_resolution": {
                "width": 768,
                "height": 1344
            },
            "generation_fps": 24,
            "steps": {
                "cpu": 8,
                "cuda": 30
            },
            "stg_blocks": {
                "indices": [
                    28
                ]
            },
            "guidance_scale": 3.0,
            "audio_guidance_scale": 7.0,
            "stg_scale": 1.0,
            "audio_stg_scale": 1.0,
            "modality_scale": 3.0,
            "audio_modality_scale": 3.0,
            "audio": {
                "enabled": true,
                "music_enabled": true
            },
            "negative_prompt": "shaky, glitchy, low quality, worst quality, deformed, distorted, disfigured, motion smear, motion artifacts, static, blurry, text, subtitles, watermark"
        }
    }
}