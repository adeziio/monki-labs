{
    "execution": {
        "mode": "local",
        "device": "auto",
        "fallback": "cpu"
    },
    "models": {
        "language_model": {
            "enabled": true,
            "provider": "ollama",
            "model": "qwen3:8b",
            "thinking": false,
            "timeout": 900
        },
        "video_model": {
            "enabled": true,
            "provider": "ltx",
            "model": "diffusers/LTX-2.3-Diffusers",
            "device_allocation": {
                "mode": "model",
                "vae_tiling": false,
                "vae_slicing": true,
                "attention_slicing": false
            },
            "generation_resolution": {
                "width": 768,
                "height": 1344
            },
            "generation_fps": 24,
            "steps": {
                "cpu": 8,
                "cuda": 20
            },
            "stg_blocks": {
                "indices": [
                    28
                ]
            },
            "guidance_scale": 3.0,
            "audio_guidance_scale": 7.0,
            "stg_scale": 1.0,
            "audio_stg_scale": 1.0,
            "modality_scale": 3.0,
            "audio_modality_scale": 3.0,
            "audio": {
                "enabled": true,
                "music_enabled": true
            },
            "negative_prompt": "shaky, glitchy, low quality, worst quality, deformed, distorted, disfigured, motion smear, motion artifacts, static, blurry, text, subtitles, watermark"
        }
    }
}